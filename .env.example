# Discord bot token (keep secret)
BOT_TOKEN=PUT_DISCORD_BOT_TOKEN_HERE
PREFIX=?
# Comma-separated Discord user IDs allowed to create/manage VPS and administer bot
ADMIN_IDS=123456789012345678
# Docker daemon socket by default; bot should run on the authorized Docker host
DOCKER_HOST=unix:///var/run/docker.sock
# Hard caps for each container
MAX_RAM=32G
MAX_CPU=8
MAX_DISK=100G
# SSHX command is an external session provider; set false to disable
SSHX_ENABLED=true
# Allowed template keys are in OS_IMAGES in bot.py
